						},
						"url": {
							"raw": "{{base_url}}/api/Auth/register",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"Auth",
								"register"
							]
						},
						"description": "Crea un nuevo usuario en la base de datos."
					},
					"response": []
				},
				{
					"name": "Iniciar Sesión (Login)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var responseJson = pm.response.json();",
									"    var token = null;",
									"    ",
									"    // Manejar respuesta directa o envuelta por RequestMiddleware",
									"    if (responseJson.data && responseJson.data.token) {",
									"        token = responseJson.data.token;",
									"    } else if (responseJson.token) {",
									"        token = responseJson.token;",
									"    }",
									"    ",
									"    if (token) {",
									"        pm.collectionVariables.set(\"token\", token);",
									"        console.log(\"Token guardado exitosamente:\", token);",
									"    }",
									"}"
								],
								"type": "javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"Correo\": \"juan.perez@example.com\",\n  \"Contrasenia\": \"Segura123!\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/Auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"Auth",
								"login"
							]
						},
						"description": "Autentica al usuario y guarda automáticamente el token de portador devuelto en la variable de la colección."
					},
					"response": []
				},
