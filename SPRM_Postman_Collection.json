		{
			"name": "8. WebSockets & ESP32 Direct Control",
			"item": [
				{
					"name": "Enviar Comando Directo por HTTP",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/ws/accion?comando=LIGHT_TOGGLE&deviceKey=dev_key_foco_sala",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"ws",
								"accion"
							],
							"query": [
								{
									"key": "comando",
									"value": "LIGHT_TOGGLE",
									"description": "El comando de texto a enviar al socket de la ESP32"
								},
								{
									"key": "deviceKey",
									"value": "dev_key_foco_sala",
									"description": "El deviceKey que identifica la conexión WebSocket activa"
								}
							]
						},
						"description": "Envía un comando de texto directamente a un socket WebSocket activo asociado a ese `deviceKey`. Nota: No requiere token de autenticación Bearer ya que no empieza con `/api`."
					},
					"response": []
				},
				{
					"name": "Conexión WebSocket (Postman WebSocket Request)",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "ws://localhost:5295/ws?deviceKey=dev_key_foco_sala",
							"protocol": "ws",
							"host": [
								"localhost"
							],
							"port": "5295",
							"path": [
								"ws"
							],
							"query": [
								{
									"key": "deviceKey",
									"value": "dev_key_foco_sala",
									"description": "Clave única del dispositivo para registrar la conexión"
								},
								{
									"key": "targetDeviceKey",
									"value": "dev_key_objetivo",
									"disabled": true,
									"description": "Opcional: Clave del dispositivo receptor para enrutar mensajes directamente"
								}
							]
						},
						"description": "Usa la funcionalidad de WebSocket Request en Postman (no una petición HTTP regular) para conectarte a la ruta `ws://localhost:5295/ws` y mantener la conexión bidireccional."
					},
					"response": []
				}
			]
		}
